{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@testmind/shared": ["packages/backend/shared/src"],
      "@testmind/core": ["packages/backend/core/src"]
    }
  },
  "include": [
    "packages/backend/shared/src/**/*.ts",
    "packages/backend/core/src/**/*.ts",
    "packages/frontend/cli/src/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/__tests__/**",
    "**/node_modules/**",
    "dist",
    "coverage",
    "packages/backend/core/src/v0.6.0.ts"
  ]
}
